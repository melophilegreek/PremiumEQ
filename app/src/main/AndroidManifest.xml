<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to attach AudioEffects (Equalizer/BassBoost/Virtualizer/LoudnessEnhancer) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Required since Android P to use android.media.audiofx.Visualizer for real-time capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Used only to read the human-readable name of a connected Bluetooth output device -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Quick Settings tile + widget update notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.audio.output" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".EqualizerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PremiumEQ"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PremiumEQ"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home screen widget: shows quick EQ toggle + active preset -->
        <receiver
            android:name=".widget.EqualizerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/equalizer_widget_info" />
        </receiver>

        <!-- Quick Settings tile: one-tap global EQ enable/disable -->
        <service
            android:name=".widget.EqualizerTileService"
            android:exported="true"
            android:icon="@drawable/ic_equalizer_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
